<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.androidagent.probe" android:versionCode="9" android:versionName="0.7.1">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <application android:label="Android Agent" android:theme="@style/AppTheme"
        android:allowBackup="false" android:extractNativeLibs="true"
        android:supportsRtl="true" android:usesCleartextTraffic="false">
        <service android:name=".AgentService" android:exported="false" android:foregroundServiceType="dataSync" />
        
        <activity android:name=".AgentActivity" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
