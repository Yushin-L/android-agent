<resources>
    <style name="AgentDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>
    <style name="AgentDialogButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="android:textColor">@color/dialog_button_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@drawable/dialog_button</item>
    </style>
    <style name="AgentPopupMenu" parent="android:style/Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/popup_surface</item>
        <item name="android:popupElevation">8dp</item>
    </style>
    <style name="AgentPopupWindow" parent="android:style/Widget.Material.PopupWindow">
        <item name="android:popupBackground">@drawable/popup_surface</item>
        <item name="android:popupElevation">8dp</item>
    </style>
    <style name="AgentDialogTitle" parent="android:style/Widget.Material.TextView">
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textColor">@color/dialog_ink</item>
    </style>
    <style name="AgentPopupText" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/dialog_ink</item>
    </style>
</resources>
